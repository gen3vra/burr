{
  "manifest_version": 3,
  "name": "Burr",
  "version": "1.0.0",
  "description": "Notes that stick. Leave a note on a site and it comes back the next time you do.",
  "browser_specific_settings": {
    "gecko": {
      "id": "burr@genevra.dev",
      "strict_min_version": "149.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "148",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Burr",
    "default_icon": {
      "16": "icons/burr-16.png",
      "32": "icons/burr-32.png"
    }
  },
  "icons": {
    "16": "icons/burr-16.png",
    "32": "icons/burr-32.png",
    "48": "icons/burr-48.png",
    "128": "icons/burr-128.png"
  }
}